    "eventMessage": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": 2
        },
        "correlation_id": {
          "$ref": "#/$defs/correlationId"
        },
        "kind": {
          "const": "event"
        },
        "event": {
          "type": "string",
          "enum": ["snapshot", "state_changed", "progress", "warning", "completed", "failed"]
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "emitted_at": {
          "$ref": "#/$defs/dateTime"
        },
        "data": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "correlation_id",
        "kind",
        "event",
        "sequence",
        "emitted_at",
        "data"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "event": {
                "const": "snapshot"
              }
            },
            "required": ["event"]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/snapshotPage"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event": {
                "const": "state_changed"
              }
            },
            "required": ["event"]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/stateChangedData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event": {
                "const": "progress"
              }
            },
            "required": ["event"]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/progressData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event": {
                "const": "warning"
              }
            },
            "required": ["event"]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/warningData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event": {
                "const": "completed"
              }
            },
            "required": ["event"]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/task"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event": {
                "const": "failed"
              }
            },
            "required": ["event"]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/failedData"
              }
            }
          }
        }
      ]
