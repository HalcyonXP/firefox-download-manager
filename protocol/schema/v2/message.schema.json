          "$ref": "#/$defs/taskState"
        }
      },
      "additionalProperties": false,
      "required": ["task", "previous_state"]
    },
    "progressData": {
      "type": "object",
      "properties": {
        "task_id": {
          "$ref": "#/$defs/taskId"
        },
        "bytes_completed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expected_size": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "speed_bytes_per_second": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "eta_seconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "active_workers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "sampled_at": {
          "$ref": "#/$defs/dateTime"
        }
      },
      "additionalProperties": false,
      "required": [
        "task_id",
        "bytes_completed",
        "expected_size",
        "speed_bytes_per_second",
        "eta_seconds",
        "active_workers",
        "sampled_at"
      ]
    },
