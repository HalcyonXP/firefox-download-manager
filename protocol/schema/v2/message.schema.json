    "prepareHandoffPayload": {
      "type": "object",
      "properties": {
        "task_id": {
          "$ref": "#/$defs/taskId"
        },
        "download": {
          "type": "object",
          "$ref": "#/$defs/addPayload",
          "not": {
            "required": ["request_context"]
          }
        }
      },
      "additionalProperties": false,
      "required": ["task_id", "download"]
    },
    "handoffResult": {
      "type": "object",
      "properties": {
        "phase": {
          "type": "string",
          "enum": ["prepared", "committed", "aborted"]
        },
        "task": {
          "$ref": "#/$defs/task"
        }
      },
      "additionalProperties": false,
      "required": ["phase", "task"],
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "const": "prepared"
              }
            },
            "required": ["phase"]
          },
          "then": {
            "properties": {
              "task": {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "queued"
                  },
                  "handoff_phase": {
                    "const": "prepared"
                  }
                },
                "required": ["state"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "aborted"
              }
            },
            "required": ["phase"]
          },
          "then": {
            "properties": {
              "task": {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "cancelled"
                  },
                  "handoff_phase": {
                    "const": "aborted"
                  }
                },
                "required": ["state"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "committed"
              }
            },
            "required": ["phase"]
          },
          "then": {
            "properties": {
              "task": {
                "type": "object",
                "properties": {
                  "handoff_phase": {
                    "const": "committed"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
